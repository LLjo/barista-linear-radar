{
  "name": "linear-radar",
  "title": "Linear Radar",
  "description": "Linear issues that involve you, unseen first",
  "icon": "linear",
  "version": "0.3.0",
  "contributes": {
    "events": [
      {
        "id": "new-issue-for-me",
        "label": "New Linear issue for me",
        "description": "An open Linear issue newly shows up in one of your lists: assigned to you, created by you, or mentioning or subscribing you. Once a list passes 50 issues or 100 notifications, an issue older than the first sync never fires, even if it is reassigned to you or mentions you later.",
        "version": 1,
        "key": "One per Linear issue (its id)",
        "fields": [
          { "name": "team", "label": "Team key", "type": "string" },
          { "name": "label", "label": "Label", "type": "string", "multi": true },
          { "name": "priority", "label": "Priority", "type": "enum", "options": ["urgent", "high", "medium", "low", "none"] },
          { "name": "assignee", "label": "Assignee", "type": "enum", "options": ["me", "someone else", "unassigned"] },
          { "name": "project", "label": "Project", "type": "string" },
          { "name": "workspace", "label": "Workspace", "type": "string" },
          { "name": "list", "label": "List", "type": "enum", "options": ["assigned", "mentions", "created"] },
          { "name": "delegate", "label": "Delegate (agent)", "type": "string" }
        ]
      },
      {
        "id": "pr-linked-for-me",
        "label": "PR linked to my Linear issue",
        "description": "A GitHub pull request is linked to an open Linear issue assigned to you (for example a coding agent the issue is delegated to opened it). Fires once per issue, when its first PR is linked; an issue that already had a PR when the workspace was first synced never fires.",
        "version": 1,
        "key": "One per Linear issue (its id)",
        "fields": [
          { "name": "team", "label": "Team key", "type": "string" },
          { "name": "label", "label": "Label", "type": "string", "multi": true },
          { "name": "priority", "label": "Priority", "type": "enum", "options": ["urgent", "high", "medium", "low", "none"] },
          { "name": "project", "label": "Project", "type": "string" },
          { "name": "workspace", "label": "Workspace", "type": "string" },
          { "name": "delegate", "label": "Delegate (agent)", "type": "string" },
          { "name": "creator", "label": "Creator", "type": "string" },
          { "name": "repo", "label": "PR repo (owner/name)", "type": "string", "multi": true }
        ]
      }
    ]
  }
}
